# Copy this file to .env.local for local development (never commit .env.local).
#
# Formspree form ID for the /contact organizational-inquiry form.
# This is a public endpoint identifier, not a secret — but it's kept
# configurable here rather than hardcoded so it can be changed without
# editing page components.
#
# In production, this is supplied by the GitHub Actions repository variable
# of the same name (see .github/workflows/pages.yml) rather than a
# committed .env file.
#
# Without this set, the inquiry form gracefully falls back to a
# direct-email prompt instead of rendering a form with nowhere to submit.
NEXT_PUBLIC_FORMSPREE_FORM_ID=
